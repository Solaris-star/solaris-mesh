<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap uap10">
  <Identity
    Name="__PACKAGE_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="__ARCHITECTURE__" />
  <Properties>
    <DisplayName>Solaris Mesh Network Proxy</DisplayName>
    <PublisherDisplayName>Solaris Mesh</PublisherDisplayName>
    <Description>Process-isolated HTTP proxy for Solaris Mesh Auto processes</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26663.0" />
  </Dependencies>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
  <Applications>
    <Application
      Id="Proxy"
      Executable="solaris-windows-network-proxy.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="appContainer"
      uap10:Subsystem="console"
      uap10:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Solaris Mesh Network Proxy"
        Description="Process-isolated HTTP proxy for Solaris Mesh Auto processes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
    </Application>
  </Applications>
</Package>
